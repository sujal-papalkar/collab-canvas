# ==============================================================================
# Backend Environment Configuration - Real-Time Collaborative Canvas (MERN)
# ==============================================================================

# Port for the Node.js Express & Socket.io server
PORT=5000

# MongoDB Connection URI
# Options:
# 1. MongoDB Atlas cloud connection: mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/collab_canvas?retryWrites=true&w=majority
# 2. Local MongoDB instance: mongodb://localhost:27017/collab_canvas
# 3. Leave empty or unconfigured to automatically launch the embedded In-Memory MongoDB Server (Zero-Config)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/collab_canvas?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Token Expiration (e.g. 7d, 24h, 3600)
JWT_EXPIRES_IN=7d

# CORS Allowed Origin for WebSockets and REST (optional, default: *)
CLIENT_ORIGIN=http://localhost:5173
