# ==============================================================================
# Root Environment Configuration Template - Real-Time Collaborative Canvas
# ==============================================================================

# Backend Port
PORT=5000

# MongoDB URI (Atlas or Local, fallback is embedded in-memory MongoDB)
# Replace with your own MongoDB Atlas URI or local MongoDB connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/collab_canvas?retryWrites=true&w=majority
# Or for local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/collab_canvas

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client Origin
CLIENT_ORIGIN=http://localhost:5173
